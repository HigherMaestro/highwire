{
  "name": "highwire",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/mcp",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "smoke": "npm run smoke --workspaces --if-present",
    "simulate": "npm run simulate -w highwire-mcp",
    "dev": "npm run dev -w highwire-mcp",
    "dev:web": "npm run dev -w highwire-web"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
