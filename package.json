{
  "name": "highwire-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/relay",
    "packages/agent",
    "packages/mcp",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "smoke": "npm run smoke --workspaces --if-present",
    "simulate": "npm run simulate -w highwire-mcp",
    "arena:sim": "npm run arena:sim -w highwire-core --",
    "dev": "npm run dev -w highwire-mcp",
    "dev:web": "npm run dev -w highwire-web",
    "test:program": "npm run wager-fixtures -w highwire-core && cargo test --release --manifest-path programs/line-wager/Cargo.toml && cd programs/line-wager && cargo build-sbf"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
