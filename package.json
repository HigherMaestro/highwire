{
  "name": "higher-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents use higher.fun, the open-source Solana launchpad",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "higher-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
