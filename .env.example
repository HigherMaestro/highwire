# All optional. Defaults shown.
HIGHER_API_URL=https://api.higher.fun
# mainnet or devnet: where transactions are quoted and built.
HIGHWIRE_CLUSTER=mainnet
# Defaults to the cluster's public RPC.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# The most SOL one built transaction may spend or return.
HIGHWIRE_MAX_SOL_PER_TX=10
HIGHER_TIMEOUT_MS=15000
HIGHER_RETRIES=2
# Hosted endpoint only (apps/web): POSTs per minute per IP.
HIGHWIRE_RATE_LIMIT=60
