# All optional. Defaults shown.
HIGHER_API_URL=https://api.higher.fun
# mainnet or devnet: where transactions are quoted and built.
HIGHWIRE_CLUSTER=mainnet
# Defaults to the cluster's public RPC.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# The most SOL one built transaction may spend or return.
HIGHWIRE_MAX_SOL_PER_TX=10
HIGHER_TIMEOUT_MS=15000
HIGHER_RETRIES=2
# Where sign_url points. http://localhost:3000 for a local site.
HIGHWIRE_SITE_URL=https://highwire.fun
# Derive launch mints from this secret instead of keeping them in memory (the hosted endpoint always derives).
# A long random string; never commit the real one.
HIGHWIRE_LAUNCH_SECRET=
# Hosted endpoint only (apps/web): units per minute per IP. A build tool call costs 5, anything else 1.
HIGHWIRE_RATE_LIMIT=60
# The sign page (apps/web): RPCs the browser calls. Public, so use keys restricted to your site's origin.
# Solana's public mainnet RPC refuses requests from web pages, so a deployed site needs its own.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
