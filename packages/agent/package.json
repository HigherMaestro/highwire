{
  "name": "highwire-agent",
  "version": "0.6.0",
  "description": "Highwire's opt-in local signer for higher.fun: a policy file, dry runs by default, and an audit log. Runs only on your machine.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HigherMaestro/highwire.git",
    "directory": "packages/agent"
  },
  "exports": {
    ".": {
      "highwire-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=highwire-source --test test/*.test.ts",
    "prepack": "npm run build && cp ../../LICENSE ."
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@solana/web3.js": "1.99.0",
    "bs58": "6.0.0",
    "highwire-core": "0.6.0",
    "zod": "4.6.7"
  }
}
