{
  "name": "highwire-core",
  "version": "0.12.0",
  "description": "Highwire's higher.fun client: the typed API, constants, unit formatting, the rug check, unsigned transaction builders and sign links",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HigherMaestro/highwire.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "highwire-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "highwire-source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=highwire-source --test test/*.test.ts",
    "record-fixtures": "tsx --conditions=highwire-source scripts/record-fixtures.ts",
    "prepack": "npm run build && cp ../../LICENSE ."
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@raydium-io/raydium-sdk-v2": "0.2.74-alpha",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.5",
    "bs58": "6.0.0"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0"
  }
}
